<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- 페이지 인디케이터 -->
    <LinearLayout
        android:id="@+id/page_indicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="16dp"
        android:contentDescription="페이지 인디케이터">

        <View
            android:id="@+id/page1"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_weight="1"
            android:background="@android:color/darker_gray"
            android:layout_margin="4dp"
            android:contentDescription="첫 번째 페이지 인디케이터"/>

        <View
            android:id="@+id/page2"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_weight="1"
            android:background="@android:color/holo_blue_light"
            android:layout_margin="4dp"
            android:contentDescription="두 번째 페이지 인디케이터"/>

        <View
            android:id="@+id/page3"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_weight="1"
            android:background="@android:color/holo_blue_light"
            android:layout_margin="4dp"
            android:contentDescription="세 번째 페이지 인디케이터"/>
    </LinearLayout>

    <!-- 안내 텍스트 -->
    <TextView
        android:id="@+id/second_info_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="나와 함께할 반려 식물의 이름을 정해봅시다."
        android:textSize="16sp"
        android:layout_gravity="start"
        android:layout_marginBottom="16dp"
        android:contentDescription="두 번째 화면 설명 텍스트" />

    <!-- 텍스트 입력 박스 -->
    <EditText
        android:id="@+id/name_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="이름을 입력해 주세요"
        android:layout_marginBottom="16dp"
        android:padding="12dp"
        android:background="@drawable/edit_text_background" />

    <!-- 다음 버튼 -->
    <Button
        android:id="@+id/next_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="다음 버튼"
        android:text="다음" />
</LinearLayout>