<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/waterback"
    tools:context=".MainActivity">

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/go_home"
        android:layout_width="490dp"
        android:layout_height="75dp"
        android:layout_centerInParent="true"
        android:background="@drawable/button_border"
        android:backgroundTint="#3F90E3"
        android:fontFamily="@font/suit_extrabold"
        android:onClick="onButtonClick"
        android:text="홈으로 가기"
        android:textSize="22sp"
        android:textColor="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.488"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.962"
        tools:ignore="TouchTargetSizeCheck" />

    <ImageView
        android:layout_width="492dp"
        android:layout_height="460dp"
        android:layout_marginTop="292dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.479"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/light"
        tools:ignore="MissingConstraints"  />

    <ImageView
        android:layout_width="286dp"
        android:layout_height="379dp"
        android:layout_marginTop="315dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/reward_tomato"
        tools:ignore="MissingConstraints" />

    <ImageView
        android:layout_width="402dp"
        android:layout_height="193dp"
        android:layout_marginTop="684dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/group592"
        tools:ignore="MissingConstraints"  />

    <TextView
        android:layout_width="376dp"
        android:layout_height="90dp"
        android:layout_marginTop="736dp"
        android:fontFamily="@font/tmoneyroundwindregular"
        android:gravity="center"
        android:text="질문의 정답을 멋지게 골랐어요.\n\n보상으로                    을 줄게요!"
        android:textSize="25sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="MissingConstraints"  />

    <TextView
        android:layout_width="151dp"
        android:layout_height="63dp"
        android:layout_marginTop="768dp"
        android:fontFamily="@font/tmoneyroundwindextrabold"
        android:gravity="center"
        android:text="10 코인"
        android:textColor="#3F90E3"
        android:textSize="33sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.465"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="MissingConstraints"/>

    <TextView
        android:layout_width="300dp"
        android:layout_height="62dp"
        android:layout_marginTop="113dp"
        android:fontFamily="@font/suit_bold"
        android:gravity="center"
        android:text="질문에 답하기 활동"
        android:textColor="#3F90E3"
        android:textSize="40sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.429"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="MissingConstraints" />

    <TextView
        android:layout_width="95dp"
        android:layout_height="87dp"
        android:layout_marginTop="117dp"
        android:fontFamily="@font/suit_bold"
        android:text="을"
        android:textColor="#000000"
        android:textSize="40sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.905"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="MissingConstraints" />

    <TextView
        android:layout_width="284dp"
        android:layout_height="109dp"
        android:layout_marginTop="148dp"
        android:fontFamily="@font/suit_bold"
        android:gravity="center"
        android:text="완료했습니다!"
        android:textColor="#000000"
        android:textSize="40sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="MissingConstraints" />


</androidx.constraintlayout.widget.ConstraintLayout>