<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <ImageView
        android:id="@+id/characterPreview"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="16dp"
        android:src="@android:drawable/ic_menu_gallery" />

    <Button
        android:id="@+id/backgroundButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/characterPreview"
        android:layout_alignParentStart="true"
        android:layout_marginStart="17dp"
        android:layout_marginTop="22dp"
        android:text="배경 아이템" />

    <Button
        android:id="@+id/itemButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/backgroundButton"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="-47dp"
        android:layout_marginEnd="26dp"
        android:text="일반 아이템" />

    <GridView
        android:id="@+id/backgroundGridView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/itemButton"
        android:numColumns="3"
        android:gravity="center"
        android:layout_gravity="center"
        android:verticalSpacing="16dp"
        android:horizontalSpacing="16dp"
        android:visibility="gone" />

    <GridView
        android:id="@+id/itemGridView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/backgroundGridView"
        android:numColumns="3"
        android:gravity="center"
        android:layout_gravity="center"
        android:verticalSpacing="16dp"
        android:horizontalSpacing="16dp"
        android:visibility="gone" />

    <Button
        android:id="@+id/purchaseButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/itemGridView"
        android:layout_alignParentStart="true"
        android:layout_marginStart="140dp"
        android:layout_marginTop="100dp"
        android:text="구매하기" />

</RelativeLayout>
