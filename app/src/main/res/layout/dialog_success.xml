<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="500dp"
    android:layout_height="450dp"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center_horizontal"
    android:background="@drawable/shop_rounded_dialog">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="상품을 구매했어요"
        android:textSize="30sp"
        android:layout_marginBottom="20dp"
        android:gravity="center" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="구매한 상품은 ‘꾸미기’에서 사용할 수 있어요."
        android:textSize="20sp"
        android:layout_marginBottom="20dp"
        android:gravity="center" />

    <!-- 아이템 이미지 -->
    <ImageView
        android:id="@+id/itemImage"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="8dp" />

    <!-- 아이템 이름 -->
    <TextView
        android:id="@+id/itemName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="아이템 이름"
        android:textSize="18sp"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="4dp" />

    <!-- 아이템 가격 -->
    <TextView
        android:id="@+id/itemPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="150 코인"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="400dp"
        android:layout_height="97dp"
        android:orientation="horizontal"
        android:gravity="center">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/confirmButton2"
            android:layout_width="10dp"
            android:layout_height="65dp"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            android:background="@drawable/button_border3"
            android:textColor="#02AE7A"
            android:text="확인"
            android:textSize="23sp"/>

        <Button
            android:id="@+id/decorateButton"
            android:layout_width="10dp"
            android:layout_height="70dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:backgroundTint="#02AE7A"
            android:text="꾸미기"
            android:textSize="23sp"/>
    </LinearLayout>
</LinearLayout>
