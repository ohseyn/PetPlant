<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/onboarding_back"
    android:padding="15dp">

    <ImageButton
        android:id="@+id/back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@mipmap/ic_back"
        tools:ignore="MissingConstraints" />

    <LinearLayout
        android:id="@+id/page_indicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="55dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:id="@+id/page1"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:background="#02AE7A"
            android:contentDescription="첫 번째 페이지 인디케이터" />

        <View
            android:id="@+id/page2"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:background="#02AE7A"
            android:contentDescription="두 번째 페이지 인디케이터" />

        <View
            android:id="@+id/page3"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:background="#B7E1CE"
            android:contentDescription="세 번째 페이지 인디케이터" />
    </LinearLayout>

    <TextView
        android:id="@+id/text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="앞으로 함께 할 반려 식물의\n이름을 지어주세요."
        android:textSize="20sp"
        android:fontFamily="@font/suit_bold"
        app:layout_constraintTop_toBottomOf="@+id/page_indicator"
        android:layout_marginTop="20dp"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/text2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="반려식물 이름 설정"
        android:textSize="18sp"
        android:fontFamily="@font/suit_bold"
        app:layout_constraintTop_toBottomOf="@+id/text"
        android:layout_marginTop="200dp"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/text3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="*초성, 띄어쓰기, 특수문자는 입력할 수 없어요."
        android:textColor="#999999"
        android:textSize="13sp"
        app:layout_constraintTop_toBottomOf="@+id/text2"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="parent"/>

    <EditText
        android:id="@+id/name_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@mipmap/textbox"
        android:hint="한글 1~5자로 입력해주세요."
        android:padding="15dp"
        android:paddingLeft="10dp"
        android:textSize="15sp"
        app:layout_constraintTop_toBottomOf="@+id/text3"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="parent"/>

    <Button
        android:id="@+id/next_button"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:backgroundTint="#02AE7A"
        android:text="다음"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
