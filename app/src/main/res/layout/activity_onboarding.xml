<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/onboarding_back"
    android:padding="16dp">

    <!-- 페이지 인디케이터 -->
    <LinearLayout
        android:id="@+id/page_indicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp"
        android:layout_weight="1"
        android:contentDescription="페이지 인디케이터"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:id="@+id/page1"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:background="#02AE7A"
            android:contentDescription="첫 번째 페이지 인디케이터" />

        <View
            android:id="@+id/page2"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:background="#B7E1CE"
            android:contentDescription="두 번째 페이지 인디케이터" />

        <View
            android:id="@+id/page3"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:background="#B7E1CE"
            android:contentDescription="세 번째 페이지 인디케이터" />
    </LinearLayout>

    <!-- 안내 텍스트 -->

    <!-- ViewPager -->

    <!-- 선택하기 버튼 -->

    <TextView
        android:layout_width="384dp"
        android:layout_height="81dp"
        android:layout_marginTop="140dp"
        android:text="나와 함께할\n반려 식물을 골라주세요."
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.056"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.viewpager.widget.ViewPager
        android:id="@+id/viewPager"
        android:layout_width="539dp"
        android:layout_height="792dp"
        android:layout_marginBottom="152dp"
        android:contentDescription="온보딩 페이지 전환 뷰"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:ignore="MissingConstraints" />

    <Button
        android:id="@+id/choose_button"
        android:layout_width="471dp"
        android:layout_height="80dp"
        android:layout_marginTop="1024dp"
        android:backgroundTint="@drawable/button_background_onboarding"
        android:enabled="false"
        android:onClick="onButtonClick"
        android:text="선택하기"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.513"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatButton
        android:layout_width="47dp"
        android:layout_height="45dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="460dp"
        android:background="@drawable/ic_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="TouchTargetSizeCheck,SpeakableTextPresentCheck" />
</androidx.constraintlayout.widget.ConstraintLayout>