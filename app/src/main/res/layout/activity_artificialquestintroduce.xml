<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/removequestback"
    tools:context=".waterquest_introduce">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0"
        tools:layout_editor_absoluteX="51dp">


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="16dp"
            android:text="활동 하기"
            android:textColor="#000000"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/instructions_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="100dp"
            android:layout_marginBottom="-25dp"
            android:text="활동하는 모습을 사진으로 남겨봅시다."
            android:textColor="#000000"
            android:textSize="22sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/instructions_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="-10dp"
            android:text="아래의 자세한 설명을 보고 활동을 진행해 봅시다."
            android:textColor="#666666"
            android:textSize="19sp" />

        <FrameLayout
            android:id="@+id/video_placeholder"
            android:layout_width="318dp"
            android:layout_height="456dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="60dp"
            android:layout_marginBottom="20dp"
            android:background="#46C140">

            <!-- 동영상이 들어갈 자리입니다 -->
            <!-- 여기에 VideoView나 다른 동영상 플레이어를 추가할 수 있습니다 -->

        </FrameLayout>

        <TextView
            android:id="@+id/instructions_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="30dp"
            android:text="방울토마토는 인공수정이 필요한 식물입니다."
            android:textColor="#000000"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/instructions_detail_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="방울토마토 화분의 겉 흙이 말랐을 때,\n물을 흠뻑 줍니다."
            android:gravity="center"
            android:textColor="#000000"
            android:textSize="18sp" />

    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/do_quest_artificial"
        android:layout_width="471dp"
        android:layout_height="80dp"
        android:layout_centerInParent="true"
        android:background="@drawable/button_border3"
        android:backgroundTint="#46C140"
        android:onClick="onButtonClick"
        android:text="사진 찍으러 가기"
        android:textSize="22sp"
        android:textColor="#FFFFFF"
        android:fontFamily="@font/suit_extrabold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.492"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.976" />


</androidx.constraintlayout.widget.ConstraintLayout>