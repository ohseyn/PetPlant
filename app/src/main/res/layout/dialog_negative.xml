<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="500dp"
    android:layout_height="350dp"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center_horizontal"
    android:background="@drawable/shop_rounded_dialog">

    <ImageView
        android:id="@+id/negativeImage"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:src="@drawable/negative_flower"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="15dp" />

    <TextView
        android:id="@+id/negativeMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="왕큰방울이가 아직 성장을 기다리고 있어요."
        android:textSize="22sp"
        android:gravity="center"
        android:layout_marginBottom="20dp" />

    <Button
        android:id="@+id/negativeConfirmButton"
        android:layout_width="200dp"
        android:layout_height="60dp"
        android:text="확인"
        android:textSize="20sp"
        android:backgroundTint="#02AE7A"
        android:textColor="#FFFFFF" />
</LinearLayout>