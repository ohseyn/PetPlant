<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="500dp"
    android:layout_height="450dp"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center_horizontal"
    android:background="@drawable/shop_rounded_dialog">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="상품을 구매할까요?"
        android:textSize="25sp"
        android:textStyle="bold"
        android:layout_marginTop="30dp"
        android:layout_marginBottom="20dp"
        android:gravity="center" />

    <!-- 아이템 이미지 -->
    <ImageView
        android:id="@+id/itemImage"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="8dp" />

    <!-- 아이템 이름 -->
    <TextView
        android:id="@+id/itemName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="아이템 이름"
        android:textSize="20sp"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="4dp" />

    <!-- 아이템 가격 -->


    <TextView
        android:id="@+id/itemPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:text="150 코인"
        android:textStyle="bold"
        android:textSize="25sp" />

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="-71dp"
        android:layout_marginTop="-37dp"
        android:background="@drawable/dialog_coin" />

    <LinearLayout
        android:layout_width="400dp"
        android:layout_height="97dp"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/cancelButton"
            android:layout_width="10dp"
            android:layout_height="65dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:background="@drawable/button_border3"
            android:text="취소"
            android:textColor="#02AE7A"
            android:textSize="23sp" />

        <Button
            android:id="@+id/confirmButton"
            android:layout_width="10dp"
            android:layout_height="70dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:backgroundTint="#02AE7A"
            android:text="구매"
            android:textSize="23sp" />
    </LinearLayout>
</LinearLayout>
