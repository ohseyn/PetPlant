<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- 버튼 배경색 -->
    <solid android:color="#FFFFFF" /> <!-- 원하는 배경 색 -->

    <!-- 버튼 테두리 -->
    <stroke
        android:width="2dp"
        android:color="#F7608F" />
    <!-- 버튼 모서리 둥글게 하기 (선택 사항) -->
    <corners android:radius="30dp" /> <!-- 원하는 둥근 정도 설정 -->

</shape>
