<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 기존 배경 -->
    <item android:drawable="@drawable/onboardingrectangle" />

    <!-- 테두리 -->
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="2dp"
                android:color="#02AE7A" /> <!-- 초록색 테두리 -->
            <corners android:radius="10dp" /> <!-- 테두리의 둥근 정도 -->
        </shape>
    </item>
</layer-list>